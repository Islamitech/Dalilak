# ====================================================================
# Dalelak WhatsApp AI Agent & Safety Radar - Environment Configuration
# ====================================================================

# Port for the standalone microservice & dashboard (Default: 3005)
PORT=3005

# Host address (0.0.0.0 for all interfaces or 127.0.0.1 for local only)
HOST=0.0.0.0

# xAI Grok API Key (can also be entered dynamically in the web dashboard)
GROK_API_KEY=

# Default Grok Model (grok-2-mini, grok-2, grok-2-vision)
GROK_MODEL=grok-2-mini

# Optional Supabase integration for direct cloud synchronization
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
